<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/text_titol_principal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enfonsa la flota"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guia_dreta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.8" />

    <SurfaceView
        android:id="@+id/surface_jugador"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@+id/text_titol_principal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/surface_rival"
        app:layout_constraintHorizontal_chainStyle="packed"/>

    <SurfaceView
        android:id="@+id/surface_rival"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@+id/text_titol_principal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/surface_jugador"
        app:layout_constraintEnd_toStartOf="@+id/guia_dreta" />

    <TextView
        android:id="@+id/text_teus_vaixells"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Els teus vaixells"
        android:textAlignment="center"
        android:background="#EAEAEA"
        android:padding="4dp"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/surface_jugador"
        app:layout_constraintStart_toStartOf="@+id/surface_jugador"
        app:layout_constraintEnd_toEndOf="@+id/surface_jugador" />

    <TextView
        android:id="@+id/text_teus_intents"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Els teus intents"
        android:textAlignment="center"
        android:background="#EAEAEA"
        android:padding="4dp"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/surface_rival"
        app:layout_constraintStart_toStartOf="@+id/surface_rival"
        app:layout_constraintEnd_toEndOf="@+id/surface_rival" />

    <TextView
        android:id="@+id/text_darrera_jugada_seva"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Darrera jugada seva:"
        android:textSize="12sp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@+id/text_teus_vaixells"
        app:layout_constraintStart_toStartOf="@+id/text_teus_vaixells"
        app:layout_constraintEnd_toEndOf="@+id/text_teus_vaixells"/>

    <TextView
        android:id="@+id/text_darrera_jugada_teva"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Darrera jugada teva:"
        android:textSize="12sp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@+id/text_teus_intents"
        app:layout_constraintStart_toStartOf="@+id/text_teus_intents"
        app:layout_constraintEnd_toEndOf="@+id/text_teus_intents"/>

    <ImageButton
        android:id="@+id/btn_aturar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/capsa"
        android:foreground="@drawable/atura"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@+id/btn_nou_joc"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/guia_dreta"
        app:layout_constraintTop_toTopOf="@+id/text_teus_intents"
        app:layout_constraintWidth_percent="0.08" />

    <ImageButton
        android:id="@+id/btn_nou_joc"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/capsa"
        android:foreground="@drawable/newgame"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_aturar"
        app:layout_constraintTop_toTopOf="@+id/btn_aturar"
        app:layout_constraintWidth_percent="0.08" />

    <ImageButton
        android:id="@+id/btn_connectar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/capsa"
        android:foreground="@drawable/online"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/btn_aturar"
        app:layout_constraintStart_toStartOf="@+id/btn_aturar"
        app:layout_constraintTop_toBottomOf="@+id/btn_aturar"
        app:layout_constraintWidth_percent="0.08" />

    <ImageButton
        android:id="@+id/btn_pista"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/capsa"
        android:foreground="@drawable/tip"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/btn_nou_joc"
        app:layout_constraintStart_toStartOf="@+id/btn_nou_joc"
        app:layout_constraintTop_toBottomOf="@+id/btn_nou_joc"
        app:layout_constraintWidth_percent="0.08" />

    <TextView
        android:id="@+id/textViewMissatges"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/capsa"
        android:scrollbars="vertical"
        android:text="Missatges:"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_connectar"
        app:layout_constraintBottom_toBottomOf="@+id/surface_rival"
        app:layout_constraintStart_toEndOf="@+id/guia_dreta"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_pistes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F8F8F8"
        android:visibility="gone"
        android:elevation="10dp"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_tancar_pistes"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/titol_pistes_jugador"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Els meus vaixells"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAlignment="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/titol_pistes_rival" />

        <TextView
            android:id="@+id/titol_pistes_rival"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Els seus vaixells"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAlignment="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/titol_pistes_jugador"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_percentatge_jugador"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Enfonsats = 0.00%"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/text_percentatge_rival" />

        <TextView
            android:id="@+id/text_percentatge_rival"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Enfonsats = 0.00%"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/text_percentatge_jugador"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_pistes_jugador"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:scrollbars="vertical"
            android:text="Carregant pistes..."
            app:layout_constraintTop_toBottomOf="@+id/titol_pistes_jugador"
            app:layout_constraintBottom_toTopOf="@+id/text_percentatge_jugador"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/text_pistes_rival" />

        <TextView
            android:id="@+id/text_pistes_rival"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"
            android:scrollbars="vertical"
            android:text="Carregant pistes..."
            app:layout_constraintTop_toBottomOf="@+id/titol_pistes_rival"
            app:layout_constraintBottom_toTopOf="@+id/text_percentatge_rival"
            app:layout_constraintStart_toEndOf="@+id/text_pistes_jugador"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>